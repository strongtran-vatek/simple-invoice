# Copy this file to .env before running anything:  cp .env.example .env
# One file configures Docker Compose, the backend and the frontend.
# Every value below is a placeholder for local use. Change the secrets for any shared environment.

# --- Database -------------------------------------------------------------
# Host and port the backend uses when it runs outside Docker.
# Inside Compose the backend always reaches the database at db:5432.
DB_HOST=localhost
# Also the host port Compose publishes PostgreSQL on. 5433 avoids clashing with a local PostgreSQL on 5432.
DB_PORT=5433
DB_USER=simpleinvoice
DB_PASSWORD=change-me
DB_NAME=simpleinvoice

# --- Backend --------------------------------------------------------------
BACKEND_PORT=3000
# Signing key for access tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds.
JWT_EXPIRES_IN=3600
# IANA timezone that decides what "today" is when deriving Overdue.
APP_TIMEZONE=UTC
# Comma-separated origins allowed by CORS: the Docker frontend and the Vite dev server.
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=8080
# Where the browser reaches the backend. Read at build time.
VITE_API_URL=http://localhost:3000

# --- Seed -----------------------------------------------------------------
# Default reviewer account created by the seed script.
SEED_USER_EMAIL=reviewer@simpleinvoice.test
SEED_USER_PASSWORD=change-me
SEED_USER_FULLNAME=Reviewer
